<?xml version="1.0" encoding="UTF-8"?>
<ivysettings>
  <property name="httpclient.version" value="4.5.13" />
  <property name="httpclient.httpcore.version" value="4.4.11" />
  <property name="httpclient.async.version" value="4.1.4" />
  <property name="jetty.version" value="9.4.44.v20210927" />
  <property name="dom4j.version" value="2.1.1" />
  <property name="com.google.guava.version" value="28.1-jre" />
  <property name="dev.home" value="${user.home}" />
  <property name="build.dir" value="${basedir}/build" />
  <property name="build.tmp.dir" value="${build.dir}/tmp" />
  <property name="dist.dir" value="${build.dir}/dist" />

  <credentials host="repo.zextras.tools" realm="Sonatype Nexus Repository Manager" username="${nexus_user}" passwd="${nexus_password}" />

  <settings defaultResolver="chain-resolver" />
  <caches defaultCacheDir="${dev.home}/.ivy2/cache" />
  <resolvers>
    <chain name="chain-resolver" returnFirst="true">
      <filesystem name="local">
        <artifact pattern="${dev.home}/.zcs-deps/[organisation]/[module]/[module]-[revision].[ext]" />
        <artifact pattern="${dev.home}/.zcs-deps/[organisation]-[revision].[ext]" />
        <artifact pattern="${dev.home}/.zcs-deps/[organisation].[ext]" />

      </filesystem>
      <ibiblio name="public-maven" m2compatible="true" root="https://repo.zextras.tools/repository/java-sdk/" />
      <url name="zextras">
        <artifact pattern="https://repo.zextras.tools/repository/java-sdk/[organisation]/[module]/[module]-[revision].[ext]" />
        <artifact pattern="https://repo.zextras.tools/repository/java-sdk/[organisation]-[revision].[ext]" />
        <artifact pattern="https://repo.zextras.tools/repository/java-sdk/[organisation].[ext]" />
        <artifact pattern="https://repo.zextras.tools/repository/java-sdk/[orgPath]/[module]/[baseRev](-[folderItegRev])/[module]-[baseRev](-[fileItegRev])(-[classifier]).[ext]" />
      </url>
    </chain>
    <!-- 'nexus-publish' resolver is not part of the chain: java-sdk is a read-only group, deploys go to the hosted repo -->
    <ibiblio name="nexus-publish" m2compatible="true" root="https://repo.zextras.tools/repository/public-maven-repo/" />
    <!-- 'build-tmp' resolver is not part of the chain and is used only for packaging war files -->
    <filesystem name="build-tmp">
      <artifact pattern="${build.tmp.dir}/[module]-[revision].[ext]" />
    </filesystem>
    <filesystem name="build-dist">
      <artifact pattern="${dist.dir}/[module]-[revision].[ext]" />
    </filesystem>
  </resolvers>
</ivysettings>
